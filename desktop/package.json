{
  "name": "carbovis",
  "productName": "CarboVis",
  "version": "1.0.0",
  "description": "Carrborobotics (FRC 7763) match log viewer, live robot view and driver station recorder",
  "author": "Carrborobotics FRC 7763",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "web": "python ../source/build.py",
    "start": "npm run web && electron .",
    "dist": "npm run web && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "org.carrborobotics.carbovis",
    "productName": "CarboVis",
    "files": ["main.js", "preload.js", "web/**", "!web/sw.js"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "CarboVis",
      "include": "build/installer.nsh",
      "artifactName": "CarboVis-Setup-${version}.${ext}"
    },
    "fileAssociations": [{ "ext": "wpilog", "name": "WPILib data log", "description": "WPILib data log", "role": "Viewer" }],
    "publish": [{ "provider": "github", "owner": "Carrborobotics", "repo": "CarboVis", "releaseType": "release" }]
  }
}
