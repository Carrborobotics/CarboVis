{
  "name": "carbovis-vendor",
  "private": true,
  "description": "Rebuilds source/vendor.js (three.js + msgpack) for offline use",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=iife --legal-comments=none --outfile=../vendor.js"
  },
  "dependencies": {
    "three": "0.170.0",
    "@msgpack/msgpack": "3.0.0-beta2",
    "@fontsource/ibm-plex-sans": "5.1.0",
    "@fontsource/ibm-plex-mono": "5.1.0",
    "@fontsource/barlow-condensed": "5.1.0"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
